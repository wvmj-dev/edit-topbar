msgstr "Aplicativos em segundo plano"

#: prefs.js:51
msgid "Left"
msgstr "Esquerda"

#: prefs.js:52
msgid "Center"
msgstr "Centro"

#: prefs.js:53
msgid "Right"
msgstr "Direita"

#: prefs.js:54
msgid "System menu icons"
msgstr "Ícones do menu do sistema"

#: prefs.js:60
msgid "Always"
msgstr "Sempre"

#: prefs.js:61
msgid "Never (only with a shortcut)"
msgstr "Nunca (só com um atalho)"

#: prefs.js:62
msgid "Only in the overview"
msgstr "Só no panorama de atividades"

#: prefs.js:63
msgid "Only outside the overview"
msgstr "Só fora do panorama de atividades"

#: prefs.js:64
msgid "Only when the pointer is over the top bar"
msgstr "Só com o ponteiro sobre a barra superior"

#: prefs.js:65
msgid "Only on empty workspaces"
msgstr "Só em espaços de trabalho vazios"

#: prefs.js:66
msgid "Only when the workspace has windows"
msgstr "Só quando o espaço de trabalho tem janelas"

#: prefs.js:107
msgid "Set Shortcut"
msgstr "Definir atalho"

#: prefs.js:108
msgid "Press the new key combination, Esc to cancel or Backspace to disable."
msgstr ""
"Pressione a nova combinação de teclas, Esc para cancelar ou Backspace para "
"desativar."

#: prefs.js:110 prefs.js:460
msgid "Cancel"
msgstr "Cancelar"

#: prefs.js:142
msgid "Reveal hidden items"
msgstr "Revelar itens ocultos"

#: prefs.js:143
msgid "Shows every hidden item; press again to hide them"
msgstr "Mostra todos os itens ocultos; pressione de novo para ocultá-los"

#: prefs.js:148
msgid "Disabled"
msgstr "Desativado"

#: prefs.js:157
msgid "Reset to default"
msgstr "Restaurar o padrão"

#: prefs.js:185
msgid ""
"Icons of the system menu can be reordered among themselves, but not moved "
"out of it."
msgstr ""
"Os ícones do menu do sistema podem ser reordenados entre si, mas não podem "
"sair dele."

#: prefs.js:195
msgid "Position"
msgstr "Posição"

#: prefs.js:212
msgid "Show"
msgstr "Mostrar"

#: prefs.js:228
msgid "Shortcut"
msgstr "Atalho"

#: prefs.js:229
msgid "Toggles this item; press again to return to the rule above"
msgstr "Alterna este item; pressione de novo para voltar à regra acima"

#: prefs.js:233
msgid "None"
msgstr "Nenhum"

#: prefs.js:242
msgid "Remove shortcut"
msgstr "Remover atalho"

#: prefs.js:263
msgid "Items"
msgstr "Itens"

#: prefs.js:268
msgid ""
"Top to bottom is left to right in the top bar. Changes apply right away."
msgstr ""
"De cima para baixo equivale a da esquerda para a direita na barra superior. "
"As mudanças valem na hora."

#: prefs.js:271
msgid "No items found"
msgstr "Nenhum item encontrado"

#: prefs.js:272
msgid "Enable the extension, then reopen this window."
msgstr "Ative a extensão e abra esta janela de novo."

#: prefs.js:390
msgid "Move left"
msgstr "Mover para a esquerda"

#: prefs.js:391
msgid "Move right"
msgstr "Mover para a direita"

#: prefs.js:425
msgid "Behavior"
msgstr "Comportamento"

#: prefs.js:431
msgid "Shortcuts"
msgstr "Atalhos"

#: prefs.js:432
msgid "Each item can also have its own shortcut, set on the Items page."
msgstr "Cada item também pode ter o próprio atalho, definido na página Itens."

#: prefs.js:436
msgid "Hide revealed items after"
msgstr "Ocultar itens revelados após"

#: prefs.js:437
msgid "Seconds; 0 keeps them visible until the shortcut is pressed again"
msgstr "Segundos; 0 os mantém visíveis até o atalho ser pressionado de novo"

#: prefs.js:442
msgid "On hover"
msgstr "Ao passar o ponteiro"

#: prefs.js:444
msgid "Hide delay"
msgstr "Atraso para ocultar"

#: prefs.js:445
msgid ""
"Milliseconds before items shown on hover hide after the pointer leaves the "
"top bar"
msgstr ""
"Milissegundos até os itens mostrados ao passar o ponteiro sumirem depois que "
"ele sai da barra superior"

#: prefs.js:450
msgid "Reset"
msgstr "Restaurar"

#: prefs.js:452
msgid "Restore the default top bar"
msgstr "Restaurar a barra superior padrão"

#: prefs.js:457
msgid "Restore the default top bar?"
msgstr "Restaurar a barra superior padrão?"

#: prefs.js:458
msgid "Positions, rules and item shortcuts will be removed."
msgstr "Posições, regras e atalhos dos itens serão removidos."

#: prefs.js:461
msgid "Restore"
msgstr "Restaurar"
