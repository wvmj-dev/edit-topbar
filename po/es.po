#: prefs.js:19
msgid "Activities"
msgstr "Actividades"

#: prefs.js:20
msgid "Clock and calendar"
msgstr "Reloj y calendario"

#: prefs.js:21
msgid "System menu"
msgstr "Menú del sistema"

#: prefs.js:22
msgid "Accessibility"
msgstr "Accesibilidad"

#: prefs.js:23
msgid "Input source"
msgstr "Fuente de entrada"

#: prefs.js:24
msgid "Dwell click"
msgstr "Clic por permanencia"

#: prefs.js:25
msgid "Screen recording"
msgstr "Grabación de pantalla"

#: prefs.js:26
msgid "Screen sharing"
msgstr "Compartición de pantalla"

#: prefs.js:27
msgid "Remote access"
msgstr "Acceso remoto"

#: prefs.js:28
msgid "Camera"
msgstr "Cámara"

#: prefs.js:29
msgid "Microphone"
msgstr "Micrófono"

#: prefs.js:30
msgid "Location"
msgstr "Ubicación"

#: prefs.js:31
msgid "Brightness"
msgstr "Brillo"

#: prefs.js:32
msgid "Thunderbolt"
msgstr "Thunderbolt"

#: prefs.js:33
msgid "Night light"
msgstr "Luz nocturna"

#: prefs.js:34
msgid "Network"
msgstr "Red"

#: prefs.js:35
msgid "Dark style"
msgstr "Estilo oscuro"

#: prefs.js:36
msgid "Do not disturb"
msgstr "No molestar"

#: prefs.js:37
msgid "Keyboard backlight"
msgstr "Retroiluminación del teclado"

#: prefs.js:38
msgid "Bluetooth"
msgstr "Bluetooth"

#: prefs.js:39
msgid "Airplane mode"
msgstr "Modo avión"

#: prefs.js:40
msgid "Auto rotate"
msgstr "Rotación automática"

#: prefs.js:41
msgid "Volume"
msgstr "Volumen"

#: prefs.js:42
msgid "Unsafe mode"
msgstr "Modo inseguro"

#: prefs.js:43
msgid "Power mode"
msgstr "Modo de energía"

#: prefs.js:44
msgid "Battery"
msgstr "Batería"

#: prefs.js:45
msgid "Background apps"
msgstr "Aplicaciones en segundo plano"

#: prefs.js:51
msgid "Left"
msgstr "Izquierda"

#: prefs.js:52
msgid "Center"
msgstr "Centro"

#: prefs.js:53
msgid "Right"
msgstr "Derecha"

#: prefs.js:54
msgid "System menu icons"
msgstr "Iconos del menú del sistema"

#: prefs.js:60 prefs.js:76
msgid "Always"
msgstr "Siempre"

#: prefs.js:61
msgid "Hidden"
msgstr "Oculta"

#: prefs.js:62
msgid "Hide automatically"
msgstr "Ocultar automáticamente"

#: prefs.js:68
msgid "A window touches the top bar"
msgstr "Una ventana toca la barra superior"

#: prefs.js:68
msgid "Like \"intellihide\": windows away from the top keep it visible"
msgstr "Como «intellihide»: las ventanas lejos de la parte superior la mantienen visible"

#: prefs.js:69
msgid "A window is maximized"
msgstr "Una ventana está maximizada"

#: prefs.js:69
msgid "On the monitor of the top bar"
msgstr "En el monitor de la barra superior"

#: prefs.js:70
msgid "The workspace has windows"
msgstr "El área de trabajo tiene ventanas"

#: prefs.js:70
msgid "Minimized windows do not count"
msgstr "Las ventanas minimizadas no cuentan"

#: prefs.js:77
msgid "Never (only with a shortcut)"
msgstr "Nunca (solo con un atajo)"

#: prefs.js:78
msgid "Only in the overview"
msgstr "Solo en la vista de actividades"

#: prefs.js:79
msgid "Only outside the overview"
msgstr "Solo fuera de la vista de actividades"

#: prefs.js:80
msgid "Only when the pointer is over the top bar"
msgstr "Solo con el puntero sobre la barra superior"

#: prefs.js:81
msgid "Only on empty workspaces"
msgstr "Solo en áreas de trabajo vacías"

#: prefs.js:82
msgid "Only when the workspace has windows"
msgstr "Solo cuando el área de trabajo tiene ventanas"

#: prefs.js:123
msgid "Set Shortcut"
msgstr "Definir atajo"

#: prefs.js:124
msgid "Press the new key combination, Esc to cancel or Backspace to disable."
msgstr "Pulse la nueva combinación de teclas, Esc para cancelar o Retroceso para desactivar."

#: prefs.js:126 prefs.js:473
msgid "Cancel"
msgstr "Cancelar"

#: prefs.js:159
msgid "Disabled"
msgstr "Desactivado"

#: prefs.js:168
msgid "Reset to default"
msgstr "Restablecer el valor predeterminado"

#: prefs.js:196
msgid ""
"Icons of the system menu can be reordered among themselves, but not moved "
"out of it."
msgstr "Los iconos del menú del sistema se pueden reordenar entre sí, pero no sacar de él."

#: prefs.js:206
msgid "Position"
msgstr "Posición"

#: prefs.js:223
msgid "Show"
msgstr "Mostrar"

#: prefs.js:239 prefs.js:568
msgid "Shortcut"
msgstr "Atajo"

#: prefs.js:240
msgid "Toggles this item; press again to return to the rule above"
msgstr "Alterna este elemento; pulse de nuevo para volver a la regla de arriba"

#: prefs.js:244
msgid "None"
msgstr "Ninguno"

#: prefs.js:253
msgid "Remove shortcut"
msgstr "Quitar atajo"

#: prefs.js:274
msgid "Items"
msgstr "Elementos"

#: prefs.js:279
msgid ""
"Top to bottom is left to right in the top bar. Changes apply right away."
msgstr "De arriba abajo equivale a de izquierda a derecha en la barra superior. Los cambios se aplican al instante."

#: prefs.js:282
msgid "No items found"
msgstr "No se encontraron elementos"

#: prefs.js:283
msgid "Enable the extension, then reopen this window."
msgstr "Active la extensión y vuelva a abrir esta ventana."

#: prefs.js:401
msgid "Move left"
msgstr "Mover a la izquierda"

#: prefs.js:402
msgid "Move right"
msgstr "Mover a la derecha"

#: prefs.js:437
msgid "Behavior"
msgstr "Comportamiento"

#: prefs.js:443
msgid "Shortcuts"
msgstr "Atajos"

#: prefs.js:444
msgid "Each item can also have its own shortcut, set on the Items page."
msgstr "Cada elemento también puede tener su propio atajo, definido en la página Elementos."

#: prefs.js:446
msgid "Reveal hidden items"
msgstr "Revelar elementos ocultos"

#: prefs.js:447
msgid "Shows every hidden item and the top bar; press again to hide them"
msgstr "Muestra todos los elementos ocultos y la barra superior; pulse de nuevo para ocultarlos"

#: prefs.js:449
msgid "Hide revealed items after"
msgstr "Ocultar los elementos revelados tras"

#: prefs.js:450
msgid "Seconds; 0 keeps them visible until the shortcut is pressed again"
msgstr "Segundos; 0 los mantiene visibles hasta pulsar el atajo de nuevo"

#: prefs.js:455
msgid "On hover"
msgstr "Al pasar el puntero"

#: prefs.js:457
msgid "Hide delay"
msgstr "Retraso para ocultar"

#: prefs.js:458
msgid ""
"Milliseconds before items shown on hover hide after the pointer leaves the "
"top bar"
msgstr "Milisegundos antes de que los elementos mostrados al pasar el puntero se oculten cuando este sale de la barra superior"

#: prefs.js:463
msgid "Reset"
msgstr "Restablecer"

#: prefs.js:465
msgid "Restore the default top bar"
msgstr "Restaurar la barra superior predeterminada"

#: prefs.js:470
msgid "Restore the default top bar?"
msgstr "¿Restaurar la barra superior predeterminada?"

#: prefs.js:471
msgid ""
"Positions, rules, item shortcuts and the top bar visibility will be reset."
msgstr "Se restablecerán las posiciones, reglas, atajos de los elementos y la visibilidad de la barra superior."

#: prefs.js:474
msgid "Restore"
msgstr "Restaurar"

#: prefs.js:500
msgid "Top Bar"
msgstr "Barra superior"

#: prefs.js:505
msgid "Visibility"
msgstr "Visibilidad"

#: prefs.js:506
msgid "While the top bar can hide, windows and the overview use its space."
msgstr "Mientras la barra superior puede ocultarse, las ventanas y la vista de actividades usan su espacio."

#: prefs.js:510
msgid "Show the top bar"
msgstr "Mostrar la barra superior"

#: prefs.js:524
msgid "Show in the overview"
msgstr "Mostrar en la vista de actividades"

#: prefs.js:528
msgid "Show when the pointer pushes the top edge"
msgstr "Mostrar cuando el puntero empuja el borde superior"

#: prefs.js:529
msgid ""
"It hides again after the pointer leaves, with the delay set on the Behavior "
"page"
msgstr "Se oculta de nuevo cuando el puntero sale, con el retraso definido en la página Comportamiento"

#: prefs.js:536
msgid "Hide automatically when"
msgstr "Ocultar automáticamente cuando"

#: prefs.js:537
msgid "Any of the checked situations hides the top bar."
msgstr "Cualquiera de las situaciones marcadas oculta la barra superior."

#: prefs.js:569
msgid "Show or hide the top bar"
msgstr "Mostrar u ocultar la barra superior"

#: prefs.js:570
msgid "Works in every mode; press again to return to the mode above"
msgstr "Funciona en todos los modos; pulse de nuevo para volver al modo de arriba"
